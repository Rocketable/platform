{
  "workspace": "/Users/you/Projects/rocketclaw",
  "database_url": "postgres://localhost/rocketclaw?sslmode=disable",
  "attachments": {
    "driver": "filesystem",
    "path": "/srv/rocketclaw/attachments"
  },
  "overlays": [
    "git@github.com:Rocketable/overlay1.git@main",
    "https://github.com/Rocketable/overlay2.git@commit-hash",
    "git@github.com:Rocketable/overlay3.git"
  ],
  "logging": {
    "level": "debug"
  },
  "server_display_name": "home lab",
  "web": {
    "admins": ["alice@example.com"],
    "tsnet": {"hostname": "rocketclaw", "tags": ["tag:rocketclaw"]}
  },
  "mcp_external": {
    "enabled": true,
    "listen_addr": "127.0.0.1:8765",
    "users": {
      "ci-bot": "set-me"
    }
  },
  "mcp_servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "env": {
        "NODE_ENV": "production"
      },
      "cwd": "."
    },
    "remote": {
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer set-me"
      }
    }
  },
  "opencode": {
    "devbox": {
      "url": "http://devbox.example.ts.net:4096",
      "password": "set-me"
    }
  },
  "permissions": {
    "contractor@example.com": [
      "Support",
      "Ops"
    ]
  },
  "slack": {
    "bot_token": "xoxb-...",
    "app_token": "xapp-...",
    "channels": [
      {
        "channel": "#channel-name",
        "agents": [
          "slack",
          "factory"
        ],
        "allowed_user_ids": [
          "U0987654321"
        ]
      },
      {
        "channel": "@",
        "agents": [
          "slack"
        ],
        "allowed_user_ids": [
          "U0987654321"
        ]
      }
    ]
  },
  "openai": {
    "api_key": "sk-...",
    "api_base_url": "https://api.openai.com/v1",
    "auth": "api_key"
  },
  "providers": {
    "work": {
      "api_key": "set-me",
      "api_base_url": "https://work.example/v1",
