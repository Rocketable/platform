{
  "workspace": "/Users/you/Projects/rocketclaw",
  "environment": [
    "EXAMPLE_API_TOKEN=set-me"
  ],
  "overlays": [
    "git@github.com:Rocketable/overlay1.git@main",
    "https://github.com/Rocketable/overlay2.git@commit-hash",
    "git@github.com:Rocketable/overlay3.git"
  ],
  "emergency_safe_words": [
    "stop"
  ],
  "thread_agents": {
    ":thread:": {
      "agent": "main",
      "pre_seed": false
    },
    ":factory:": {
      "agent": "factory",
      "pre_seed": false
    }
  },
  "logging": {
    "level": "debug"
  },
  "mcp_external": {
    "enabled": true,
    "listen_addr": "127.0.0.1:8765"
  },
  "slack": {
    "enabled": true,
    "bot_token": "xoxb-...",
    "app_token": "xapp-...",
    "room": "D0123456789",
    "human_user_id": "U0123456789",
    "social_mode": {
      "enabled": false,
      "channels": [
        {
          "channel": "#channel-name",
          "agents": [
            "main"
          ],
          "allowed_user_ids": [
            "U0987654321"
          ]
        }
      ],
      "context_messages": 10
    }
  },
  "openai": {
    "api_key": "sk-...",
    "api_base_url": "https://api.openai.com/v1",
    "rocketcode_auth": "api_key"
  },
  "instrumentation": {
    "enabled": false,
    "collector_endpoint": "http://localhost:6006",
    "project_name": "rocketclaw-dev",
    "api_key": "",
    "hide_inputs": true,
    "hide_outputs": true
  }
}
